{
  "name": "seeknay-links",
  "version": "1.0.0",
  "type": "module",
  "description": "Social links page with automated follower count updates",
  "scripts": {
    "update-metrics": "node scripts/update-social-metrics.mjs",
    "test": "npm run lint && npm run test:unit && npm run validate",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "validate": "node scripts/validate-site.mjs",
    "sync-links": "node scripts/sync-links.mjs && prettier --write index.html 404.html",
    "serve": "node scripts/serve.mjs"
  },
  "author": "seeknay",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.8.1",
    "eslint-plugin-html": "^8.1.4",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
