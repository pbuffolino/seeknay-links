{
  "name": "seeknay-links",
  "version": "1.0.0",
  "type": "module",
  "description": "Social links page with automated follower count updates",
  "scripts": {
    "update-metrics": "node scripts/update-social-metrics.mjs",
    "test": "npm run lint && npm run test:unit && npm run validate",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && npm run version-assets",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "validate": "node scripts/validate-site.mjs",
    "sync-links": "node scripts/sync-links.mjs && npm run version-assets",
    "serve": "node scripts/serve.mjs",
    "health:live": "node scripts/live-health.mjs",
    "version-assets": "node scripts/version-assets.mjs && prettier --write index.html 404.html"
  },
  "author": "seeknay",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.13.0",
    "parse5": "^8.0.1",
    "prettier": "^3.9.10"
  }
}
